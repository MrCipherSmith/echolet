{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echolet.local/schemas/cli-prototype/client-config.schema.json",
  "title": "Echolet CLI prototype client configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "profile_id",
    "relay_url",
    "database_path",
    "store_key_env",
    "request_timeout_ms",
    "poll_batch_size"
  ],
  "properties": {
    "profile_version": { "const": 1 },
    "profile_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "relay_url": { "type": "string", "format": "uri" },
    "database_path": { "type": "string", "minLength": 1 },
    "store_key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "request_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "poll_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
