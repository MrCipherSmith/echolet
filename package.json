{
  "name": "echolet",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "sh scripts/hooks/install.sh",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:go": "sh scripts/gate/go-tests.sh",
    "hooks:install": "sh scripts/hooks/install.sh",
    "hooks:verify": "sh scripts/hooks/verify.sh",
    "gate:docs": "sh scripts/gate/docs-freshness.sh",
    "gate:range": "sh scripts/gate/pushed-range.sh",
    "gate:selftest": "sh scripts/gate/selftest.sh",
    "mobile:start": "pnpm --filter @echolet/mobile start",
    "relay:dev": "go run ./apps/relay/cmd/relay",
    "web:build": "node apps/web/build.mjs",
    "web:start": "bash scripts/start-web.sh",
    "web:alice": "sh scripts/run-web-alice.sh",
    "web:bob": "sh scripts/run-web-bob.sh"
  },
  "devDependencies": {
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.0.8"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.9",
    "expo": "^55.0.11",
    "react-dom": "^19.2.4",
    "react-native": "^0.84.1",
    "react-native-web": "^0.21.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
