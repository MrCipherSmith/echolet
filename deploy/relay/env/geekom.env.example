# Echolet relay — geekom.tail5a88fb.ts.net
#
# Copy to geekom.env on the operator's machine (or on the host) and fill in
# ECHOLET_BIND_ADDR. geekom.env is not committed; only this .example is.
#
#   cp env/geekom.env.example env/geekom.env
#   docker compose --env-file env/geekom.env -f docker-compose.yml up -d
#
# NOTHING IN THIS FILE IS A SECRET AND NOTHING IN IT MAY EVER BECOME ONE.
# The certificate and key are files on the host, referenced by path below and
# mounted read-only. Do not add key material, tokens or passwords here.

# --- image -------------------------------------------------------------------
# Exact tag, never `latest`. Built by ../build-image.sh and transferred with
# `docker save | ssh geekom docker load`. `sudo` on geekom needs a password, but
# the user altsay is in the docker group, so none of this needs sudo except the
# `tailscale cert` step and the chown that follows it.
ECHOLET_IMAGE=echolet-relay:REPLACE_WITH_BUILT_TAG

ECHOLET_STACK_NAME=echolet-relay
ECHOLET_CONTAINER_NAME=echolet-relay

# --- network -----------------------------------------------------------------
# The host's own tailnet IPv4. Get it on geekom with:  tailscale ip -4
# NEVER 0.0.0.0: Docker's published-port DNAT is evaluated before ufw, so
# 0.0.0.0 here exposes the relay on every interface regardless of the firewall.
ECHOLET_BIND_ADDR=REPLACE_WITH_TAILSCALE_IPV4
ECHOLET_PORT=8443

# --- identity ----------------------------------------------------------------
ECHOLET_NODE_CALLSIGN=RPT-GEEKOM-01

# --- TLS ---------------------------------------------------------------------
# Directory holding cert.pem and key.pem as written by
#   sudo tailscale cert --cert-file .../cert.pem --key-file .../key.pem geekom.tail5a88fb.ts.net
# Mounted read-only into the container. Renewal rewrites these two files in
# place and the running relay picks them up within the reload interval — no
# restart, no downtime.
ECHOLET_TLS_DIR=/etc/echolet/tls
ECHOLET_TLS_RELOAD_INTERVAL_SECONDS=60

# --- data --------------------------------------------------------------------
# Badger data directory. Must be chowned to 10001:10001 before first start.
ECHOLET_HOST_DATA_DIR=/var/lib/echolet

# --- process -----------------------------------------------------------------
ECHOLET_UID=10001
ECHOLET_GID=10001
ECHOLET_LOG_LEVEL=info
ECHOLET_LOG_MAX_SIZE=20m
ECHOLET_LOG_MAX_FILE=5

# --- bounds ------------------------------------------------------------------
# Relay defaults, restated so the deployed configuration is recorded rather than
# implied. ECHOLET_MAX_UNACKED_ENVELOPES_PER_SENDER and ECHOLET_MAX_MAILBOX_BATCH
# were sized against each other by the flood closure; change one and you must
# re-reason about the other.
ECHOLET_MAILBOX_TTL_HOURS=168
ECHOLET_MAX_MESSAGE_BYTES=262144
ECHOLET_MAX_MAILBOX_BATCH=100
ECHOLET_MAX_UNACKED_ENVELOPES_PER_SENDER=16
ECHOLET_RATE_LIMIT_PER_MINUTE=120
ECHOLET_CHALLENGE_TTL_SECONDS=60
ECHOLET_CLEANUP_INTERVAL_SECONDS=60
# Declared by the relay and enforced nowhere. Recorded, not relied on.
ECHOLET_MAX_STORAGE_BYTES=2147483648
