# Echolet relay — INSECURE LOOPBACK-ONLY deployment. PLAIN HTTP, NO TLS.
#
# This template reproduces the two relays running on geekom and depr today. It
# is host-agnostic on purpose: the only per-host value is the callsign, because
# the publish address is loopback on every host by definition.
#
#   cp env/insecure-loopback.env.example env/insecure-loopback.env
#   $EDITOR env/insecure-loopback.env        # image tag + callsign
#   ./run-relay.sh env/insecure-loopback.env --print    # read the command first
#   ./run-relay.sh env/insecure-loopback.env
#
# or, with the compose plugin:
#
#   docker compose --env-file env/insecure-loopback.env \
#     -f docker-compose.insecure-loopback.yml up -d
#
# ---------------------------------------------------------------------------
# WHY THIS FILE EXISTS, AND WHAT IT COSTS
# ---------------------------------------------------------------------------
#
# The tailnet's HTTPS Certificates toggle is off (deployment runbook §3.1), so
# `tailscale cert` issues nothing and there is no certificate pair to mount. The
# relay does not degrade to plain HTTP when a certificate is missing — it exits
# non-zero — so the TLS artifacts cannot start anything today.
#
# This file is the explicit, loud alternative: plain HTTP, published on 127.0.0.1
# only, so nothing off the host can reach it. It is NOT what happens when a
# certificate is missing; it is what happens when an operator types the
# acknowledgement below. `env/geekom.env.example` and `env/depr.env.example`
# remain the intended production shape and are unchanged.
#
# What you give up: on-the-wire confidentiality from the relay. Anything running
# on this host can read every request and response in the clear. Reaching the
# relay from another machine means an SSH local forward, and then the encryption
# on that wire is SSH's, not the relay's. That is NOT evidence for AC4.
#
# NOTHING IN THIS FILE IS A SECRET AND NOTHING IN IT MAY EVER BECOME ONE.

# --- the acknowledgement -----------------------------------------------------
# Exact string, or run-relay.sh refuses to start and names the value it got.
# Deleting this line gives you the normal TLS deployment, which will then fail
# on the missing ECHOLET_TLS_DIR. There is no silent path between the two.
ECHOLET_INSECURE_LOOPBACK_ONLY=yes-plain-http-on-loopback-only

# --- image -------------------------------------------------------------------
# Exact tag, never `latest`. Built by ../build-image.sh on the operator's
# machine and transferred with `docker save | ssh <host> docker load`.
ECHOLET_IMAGE=echolet-relay:REPLACE_WITH_BUILT_TAG

ECHOLET_STACK_NAME=echolet-relay
ECHOLET_CONTAINER_NAME=echolet-relay

# --- network -----------------------------------------------------------------
# 127.0.0.1 or [::1]. Nothing else: run-relay.sh refuses any other value while
# ECHOLET_INSECURE_LOOPBACK_ONLY is set, and docker-compose.insecure-loopback.yml
# does not read this variable at all — it hardcodes 127.0.0.1.
#
# This is not belt-and-braces. Docker's published-port DNAT is evaluated before
# ufw's INPUT chain, so a wrong address here is not caught by any firewall on
# either host; the address IS the access control.
ECHOLET_BIND_ADDR=127.0.0.1
ECHOLET_PORT=8443

# --- identity ----------------------------------------------------------------
# The one per-host value. RPT-GEEKOM-01 on geekom, RPT-DEPR-01 on depr.
ECHOLET_NODE_CALLSIGN=REPLACE_WITH_CALLSIGN

# --- TLS ---------------------------------------------------------------------
# Deliberately absent. ECHOLET_TLS_DIR must NOT be set in this file:
# run-relay.sh treats a TLS directory alongside the acknowledgement as a
# contradiction and refuses, rather than guessing which half you meant.

# --- data --------------------------------------------------------------------
# A NAMED DOCKER VOLUME, not a host path. Docker seeds a fresh named volume from
# the image's /var/lib/echolet, which the Dockerfile already chowns to
# 10001:10001 — so the container owns its data directory with no host-side mkdir
# and no host-side chown, and the whole deployment stays inside the `docker`
# group. On geekom, whose `altsay` has password-gated sudo, that is the
# difference between a scriptable deployment and an interactive one.
#
# Set ECHOLET_DATA_VOLUME or ECHOLET_HOST_DATA_DIR, never both.
ECHOLET_DATA_VOLUME=echolet-relay-data

# --- process -----------------------------------------------------------------
ECHOLET_UID=10001
ECHOLET_GID=10001
ECHOLET_LOG_LEVEL=info
ECHOLET_LOG_MAX_SIZE=20m
ECHOLET_LOG_MAX_FILE=5

# --- bounds ------------------------------------------------------------------
# Identical to the TLS templates, and identical across both hosts.
# ECHOLET_MAX_UNACKED_ENVELOPES_PER_SENDER and ECHOLET_MAX_MAILBOX_BATCH were
# sized against each other by the flood closure; change one and you must
# re-reason about the other.
ECHOLET_MAILBOX_TTL_HOURS=168
ECHOLET_MAX_MESSAGE_BYTES=262144
ECHOLET_MAX_MAILBOX_BATCH=100
ECHOLET_MAX_UNACKED_ENVELOPES_PER_SENDER=16
ECHOLET_RATE_LIMIT_PER_MINUTE=120
ECHOLET_CHALLENGE_TTL_SECONDS=60
# Envelope retention is the store's own TTL: Badger expires records at
# ECHOLET_MAILBOX_TTL_HOURS above, with no sweep to schedule. There is therefore
# no cleanup interval to set here — the relay's cleanup ticker deletes nothing,
# and a dial that turns nothing does not belong in an operator's env file
# (flow 003, T28).
# Declared by the relay and enforced nowhere. Recorded, not relied on.
ECHOLET_MAX_STORAGE_BYTES=2147483648
