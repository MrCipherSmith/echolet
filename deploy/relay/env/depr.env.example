# Echolet relay — depr.tail5a88fb.ts.net
#
# Copy to depr.env on the operator's machine (or on the host) and fill in
# ECHOLET_BIND_ADDR. depr.env is not committed; only this .example is.
#
#   cp env/depr.env.example env/depr.env
#   docker compose --env-file env/depr.env -f docker-compose.yml up -d
#
# NOTHING IN THIS FILE IS A SECRET AND NOTHING IN IT MAY EVER BECOME ONE.
# The certificate and key are files on the host, referenced by path below and
# mounted read-only. Do not add key material, tokens or passwords here.

# --- image -------------------------------------------------------------------
# Exact tag, never `latest`. depr has 4 cores and 7.6 GiB and no Go toolchain,
# so the image is built on the operator's machine and loaded here. The user
# `ubuntu` has passwordless sudo and is in the docker group.
ECHOLET_IMAGE=echolet-relay:REPLACE_WITH_BUILT_TAG

ECHOLET_STACK_NAME=echolet-relay
ECHOLET_CONTAINER_NAME=echolet-relay

# --- network -----------------------------------------------------------------
# The host's own tailnet IPv4. Get it on depr with:  tailscale ip -4
# NEVER 0.0.0.0. depr has an ACTIVE ufw, and that is exactly why this matters:
# Docker's published-port DNAT runs before ufw's INPUT chain, so a 0.0.0.0
# publish is reachable from every interface on a host whose firewall says no.
# The bind address is the access control here, not ufw.
ECHOLET_BIND_ADDR=REPLACE_WITH_TAILSCALE_IPV4
ECHOLET_PORT=8443

# --- identity ----------------------------------------------------------------
ECHOLET_NODE_CALLSIGN=RPT-DEPR-01

# --- TLS ---------------------------------------------------------------------
# Directory holding cert.pem and key.pem as written by
#   sudo tailscale cert --cert-file .../cert.pem --key-file .../key.pem depr.tail5a88fb.ts.net
ECHOLET_TLS_DIR=/etc/echolet/tls
ECHOLET_TLS_RELOAD_INTERVAL_SECONDS=60

# --- data --------------------------------------------------------------------
# Must be chowned to 10001:10001 before first start.
ECHOLET_HOST_DATA_DIR=/var/lib/echolet

# --- process -----------------------------------------------------------------
ECHOLET_UID=10001
ECHOLET_GID=10001
ECHOLET_LOG_LEVEL=info
ECHOLET_LOG_MAX_SIZE=20m
ECHOLET_LOG_MAX_FILE=5

# --- bounds ------------------------------------------------------------------
# Relay defaults, restated so the deployed configuration is recorded rather than
# implied. Deliberately identical to geekom's: two relays that disagree about
# retention or message size would make any cross-relay observation ambiguous.
ECHOLET_MAILBOX_TTL_HOURS=168
ECHOLET_MAX_MESSAGE_BYTES=262144
ECHOLET_MAX_MAILBOX_BATCH=100
ECHOLET_MAX_UNACKED_ENVELOPES_PER_SENDER=16
ECHOLET_RATE_LIMIT_PER_MINUTE=120
ECHOLET_CHALLENGE_TTL_SECONDS=60
ECHOLET_CLEANUP_INTERVAL_SECONDS=60
# Declared by the relay and enforced nowhere. Recorded, not relied on.
ECHOLET_MAX_STORAGE_BYTES=2147483648
